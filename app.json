{
  "expo": {
    "name": "WallCraft",
    "slug": "WallCraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon3.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon3.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
