          "imageWidth": 600
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon2.png",
        "backgroundColor": "#000000"
      },
      "package": "com.faiziop05.WallCraft"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b7019daf-c533-44ad-9c12-033d13ed3794"
      }
    }
